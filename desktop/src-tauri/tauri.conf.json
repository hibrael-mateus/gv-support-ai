{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GV Support AI",
  "mainBinaryName": "GV Support AI",
  "version": "1.1.0",
  "identifier": "br.com.gvdasa.gvsupportai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GV Support AI",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "GV Dasa",
    "shortDescription": "Investigação técnica assistida por IA para o suporte GV Dasa",
    "category": "Productivity",
    "copyright": "GV Dasa",
    "resources": {
      "../../backend/dist/gv-support-backend/": "backend/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "startMenuFolder": "GV Support AI"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
