# GV Support AI - variáveis de ambiente (opcional; o instalador não precisa de nenhuma).
# Nenhuma credencial vai neste arquivo: chaves de API e o token do Google ficam no
# Gerenciador de Credenciais do Windows, configurados pela tela Configurações.

# Pasta raiz autorizada do Google Drive ("Fontes do Notebook LM"). Não é editável pela interface.
ALLOWED_GOOGLE_DRIVE_FOLDER_ID=1RMbftBX58SM2PblBpw8vVaRoBF8sK_3c

# Pasta de dados (padrão: %LOCALAPPDATA%\GVSupportAI). Útil para testes.
# GV_SUPPORT_DATA_DIR=C:\Temp\gvsupport-dev

# Porta do backend em desenvolvimento (o app instalado escolhe uma porta livre sozinho).
# GV_PORT=8765

# Frontend em modo navegador (npm run dev) apontando para outro backend.
# VITE_API_URL=http://127.0.0.1:8765
